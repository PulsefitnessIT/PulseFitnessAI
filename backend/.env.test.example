# GymAxis — Stripe TEST mode env file
#
# Iter 216o-5 (Feb 2026) — drop a real test-mode set of Stripe keys here
# so `pytest tests/test_stripe_integration_216o.py` can run a full
# checkout-creation + webhook-handling integration sweep WITHOUT touching
# live billing. The pytest suite skips these tests gracefully when this
# file is missing or values are placeholders.
#
# Where to get these:
#   1) Stripe Dashboard → toggle "Test mode" (top-right)
#   2) Developers → API keys                → STRIPE_API_KEY (sk_test_…)
#                                            STRIPE_PUBLISHABLE_KEY (pk_test_…)
#   3) Developers → Webhooks → Add endpoint → STRIPE_WEBHOOK_SECRET (whsec_…)
#                Endpoint URL: https://maintenance-hub-357.preview.emergentagent.com/api/webhook/stripe
#                Events: checkout.session.completed,
#                         customer.subscription.deleted,
#                         invoice.payment_failed,
#                         invoice.paid
#   4) Re-create your 12 Prices in TEST mode (Stripe keeps test/live
#      catalogues separate). Easiest: Dashboard → Products → click each
#      product → "Copy to test mode".
#
# After populating: copy this file to .env.test and run:
#     cd /app/backend && pytest tests/test_stripe_integration_216o.py -v
#
# .env.test is gitignored — never commit real keys.

STRIPE_API_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_test_REPLACE_ME

# Test-mode Price IDs. Same env var names as live so tests can compare
# behaviour parity against the live catalogue.
STRIPE_PRICE_GYMAXIS_PRO=price_REPLACE_ME
STRIPE_PRICE_GYMAXIS_PRO_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_SITE_ADDON=price_REPLACE_ME
STRIPE_PRICE_SITE_ADDON_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_MEMBERSHIPS=price_REPLACE_ME
STRIPE_PRICE_MEMBERSHIPS_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_CRM=price_REPLACE_ME
STRIPE_PRICE_CRM_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_MARKETING=price_REPLACE_ME
STRIPE_PRICE_MARKETING_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_OPERATIONS=price_REPLACE_ME
STRIPE_PRICE_OPERATIONS_ANNUAL=price_REPLACE_ME
