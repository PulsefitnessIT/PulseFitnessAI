# GymAxis AI — backend .env template
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All keys are REQUIRED unless noted optional.

# ── MongoDB ────────────────────────────────────────────────────────
MONGO_URL=
DB_NAME=

# ── CORS (comma-separated; "*" is dev-only) ────────────────────────
CORS_ORIGINS=

# ── Emergent LLM (single key covers OpenAI / Anthropic / Gemini) ───
EMERGENT_LLM_KEY=

# ── Stripe (live or test) ──────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Resend (transactional email) ───────────────────────────────────
RESEND_API_KEY=
SENDER_EMAIL=
TEST_RECIPIENT_EMAIL=

# ── JWT ────────────────────────────────────────────────────────────
#   JWT_SECRET MUST be ≥ 32 chars of entropy — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# ── Frontend / platform ────────────────────────────────────────────
REACT_APP_BACKEND_URL=
FRONTEND_URL=

# ── Master admin bootstrap (optional — remove after first boot) ────
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# ── Test / CI bypass secret (optional — dev only) ──────────────────
# RATE_LIMIT_BYPASS_SECRET=

# ── Master-admin IP allowlist (optional — comma-separated CIDR) ────
# MASTER_ADMIN_IP_ALLOWLIST=
