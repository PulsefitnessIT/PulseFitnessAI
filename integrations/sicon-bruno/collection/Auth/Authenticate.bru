meta {
  name: Authenticate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/Auth/Authenticate?companyId={{companyId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{process.env.SICON_PASSWORD}}"
  }
}

script:post-response {
  if (res.body && (res.body.token || res.body.access_token)) {
    bru.setEnvVar('BEARER_TOKEN', res.body.token || res.body.access_token);
  }
}

docs {
  VERIFY the auth URL/body against the Sicon.WebApi.Platform collection.
  Sets BEARER_TOKEN on the Plugin Platform environment on success.
}
