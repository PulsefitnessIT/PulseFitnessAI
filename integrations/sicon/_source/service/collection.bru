headers {
  Accept: application/json
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{BEARER_TOKEN}}
}

vars:pre-request {
  caseId: 0
  caseNumber: 0
  appointmentId: 0
  timeBookingId: 0
  trackingNoteId: 0
  equipmentId: 0
  caseTypeId: 0
  priorityId: 0
  trackingStatusId: 0
  statusId: 0
  employeeId: 0
}

docs {
  Collection variables below are Service Management entity ids used in path/query for this plugin.
  Defaults are 0 — set real ids before Put/smoke-write tests so requests do not target live records by accident.
  Sage connection companyId comes from the Plugin Platform global environment (?companyId=).
}
