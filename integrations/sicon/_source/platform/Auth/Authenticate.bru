meta {
  name: Authenticate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/authentication/authenticate
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.accessToken) {
    bru.setGlobalEnvVar("BEARER_TOKEN", body.accessToken);
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Platform JWT authentication (AuthenticationApiController). Post-response script sets BEARER_TOKEN on the active global environment (import Plugin Platform.json) for use by this collection and by plugin collections (e.g. CRM).
}
