meta {
  name: GetMany
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/service/case-tracking-statuses
  body: none
  auth: inherit
}

params:query {
  query: $max={{pageSize}}
  companyId: {{companyId}}
}

tests {
  test("HTTP status is success", function () { expect(res.getStatus()).to.be.within(200, 299); });
  const b = res.getBody() || {};
  const arr = Array.isArray(b) ? b : (b.data || b.items || b.results || b.records || []);
  const item = arr.length ? arr[0] : (Array.isArray(b) ? {} : b);
  console.log("selectedTrackingStatusId options (set manually, do NOT auto-select):", arr.map(function (x) { return { id: x.siSMTrackingStatusId != null ? x.siSMTrackingStatusId : x.id, name: x.name }; }));
}

docs {
  Selection lookup — do NOT auto-select the first row.
  Pick a value from the response (siSMTrackingStatusId = id, name = label) and set {{selectedTrackingStatusId}} in the environment.
  
}
