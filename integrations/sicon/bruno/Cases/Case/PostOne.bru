script:post-response {
  const b = res.getBody() || {};
  const item = (b && b.data && !Array.isArray(b)) ? b.data : b;
  if (item) {
    if (item.siSMCaseId != null) bru.setEnvVar('caseId', item.siSMCaseId);
    else if (item.id != null) bru.setEnvVar('caseId', item.id);
    if (item.caseNumber != null) bru.setEnvVar('caseNumber', item.caseNumber);
    else if (item.id != null) bru.setEnvVar('caseNumber', item.id);
  }
}

docs {
  ⚠ Case create is POST /api/ServiceCase/CreateNewCase per the Service WebAPI.
  
  ### Field mapping — this request body
  Legend: Bruno var `{{appointmentId}}` | Sicon field `siconAppointmentId` | Pulse field `appointment.sicon_appointment_id`
  
  | Sicon field | Pulse field (PulseFitness.ai) | Direction | Confirmation |
  |---|---|---|---|
  | `siSMCaseId` | `issue.sicon_case_id` | Bidirectional | SICON CONFIRMATION REQUIRED |
  | `caseNumber` | `issue.sicon_case_number` | Bidirectional | SICON CONFIRMATION REQUIRED |
  | `siSMDocumentStatusId` | `issue.status` | Bidirectional | SICON CONFIRMATION REQUIRED |
  | `siSMDocumentStatusName` | `issue.status` | Sicon→Pulse | SICON CONFIRMATION REQUIRED |
  | `siSMDocumentSubStatusId` | `issue.workflow_state / sub_status_id` | Pulse→Sicon | SICON CONFIRMATION REQUIRED |
  | `summary` | `issue.machine_type + serial_number` | Bidirectional | SICON CONFIRMATION REQUIRED |
  | `description` | `issue.issue_description` | Bidirectional | SICON CONFIRMATION REQUIRED |
  | `callDate` | `issue.created_at` | Pulse→Sicon | SICON CONFIRMATION REQUIRED |
  | `contactName` | `issue.created_by_name / reporter_name` | Pulse→Sicon | SICON CONFIRMATION REQUIRED |
  | `contactPhoneNumber` | `issue.reporter_phone` | Pulse→Sicon | SICON CONFIRMATION REQUIRED |
  | `contactEmail` | `issue.reporter_email / user_email` | Pulse→Sicon | SICON CONFIRMATION REQUIRED |
  | `lastUpdatedDate` | `issue.sicon_last_updated_at` | Sicon→Pulse | SICON CONFIRMATION REQUIRED |
  | `isNonContract` | `(Sicon-owned metadata)` | Sicon metadata | SICON CONFIRMATION REQUIRED |
  | `address` | `site.address (composed)` | Pulse→Sicon | SICON CONFIRMATION REQUIRED |
  | `postalName` | `issue.site_address.name` | Pulse→Sicon | SICON CONFIRMATION REQUIRED |
  | `addressLine1` | `engineer.address_line1` | Sicon→Pulse | SICON CONFIRMATION REQUIRED |
