meta {
  name: GetOne_ById
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/service/cases/{{caseId}}
  body: none
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

tests {
  test("HTTP status is success", function () { expect(res.getStatus()).to.be.within(200, 299); });
  const b = res.getBody() || {};
  const arr = Array.isArray(b) ? b : (b.data || b.items || b.results || b.records || []);
  const item = arr.length ? arr[0] : (Array.isArray(b) ? {} : b);
  test("field siSMCaseId present", function () { expect(item).to.have.property("siSMCaseId"); });
  bru.setVar("_type_siSMCaseId", item ? typeof item["siSMCaseId"] : "undefined");
  test("field caseNumber present", function () { expect(item).to.have.property("caseNumber"); });
  bru.setVar("_type_caseNumber", item ? typeof item["caseNumber"] : "undefined");
  test("field statusId present", function () { expect(item).to.have.property("statusId"); });
  bru.setVar("_type_statusId", item ? typeof item["statusId"] : "undefined");
  test("field appointmentId present", function () { expect(item).to.have.property("appointmentId"); });
  bru.setVar("_type_appointmentId", item ? typeof item["appointmentId"] : "undefined");
}

script:post-response {
  const b = res.getBody() || {};
  const item = (b && b.data && !Array.isArray(b)) ? b.data : b;
  if (item) {
    if (item.siSMCaseId != null) bru.setEnvVar('caseId', item.siSMCaseId);
    else if (item.id != null) bru.setEnvVar('caseId', item.id);
    if (item.caseNumber != null) bru.setEnvVar('caseNumber', item.caseNumber);
    else if (item.id != null) bru.setEnvVar('caseNumber', item.id);
  }
}

docs {
  See FIELD_MAPPING.md / mapping.csv for the full Case field map (Bruno var vs Sicon field vs Pulse field, with direction).
  
}
