meta {
  name: PostOne
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/Service/Cases/{{caseId}}/TrackingNotes
  body: json
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "siSMCaseTrackingNoteId": null,
    "note": "Example tracking note",
    "time": null,
    "status": "",
    "statusId": {{statusId}},
    "appointmentId": {{appointmentId}},
    "visibleToEngineer": true,
    "visibleToCustomer": false,
    "reassignedToCaseOwnerId": null,
    "reassignedToInternalTeamId": null,
    "reassignedToExternalTeamId": null,
    "latitude": null,
    "longitude": null
  }
}


script:post-response {
  const b = res.getBody() || {};
  const item = (b && b.data && !Array.isArray(b)) ? b.data : b;
  if (item) {
    if (item.siSMCaseTrackingNoteId != null) bru.setEnvVar('trackingNoteId', item.siSMCaseTrackingNoteId);
    else if (item.id != null) bru.setEnvVar('trackingNoteId', item.id);
  }
}

docs {
  ### Field mapping — this request body
  Legend: Bruno var `{{appointmentId}}` | Sicon field `siconAppointmentId` | Pulse field `appointment.sicon_appointment_id`
  
  | Sicon field | Pulse field (PulseFitness.ai) | Direction | Confirmation |
  |---|---|---|---|
  | `siSMCaseTrackingNoteId` | `issue.sicon_latest_note_id` | Sicon→Pulse | SICON CONFIRMATION REQUIRED |
  | `note` | `issue.latest_note` | Sicon→Pulse |  |
  | `time` | `note.timestamp` | Bidirectional |  |
  | `status` | `issue.sicon_tracking_status` | Sicon→Pulse |  |
  | `statusId` | `issue.sicon_tracking_status_id` | Bidirectional |  |
  | `appointmentId` | `issue.sicon_appointment_id` | Sicon→Pulse |  |
  | `visibleToEngineer` | `note.visible_to_engineer` | Bidirectional |  |
  | `visibleToCustomer` | `note.visible_to_customer` | Bidirectional |  |
  | `reassignedToCaseOwnerId` | `(Sicon-owned metadata)` | Sicon metadata |  |
  | `reassignedToInternalTeamId` | `(Sicon-owned metadata)` | Sicon metadata |  |
  | `reassignedToExternalTeamId` | `(Sicon-owned metadata)` | Sicon metadata |  |
  | `latitude` | `note.latitude` | Pulse→Sicon |  |
  | `longitude` | `note.longitude` | Pulse→Sicon |  |
  
}
