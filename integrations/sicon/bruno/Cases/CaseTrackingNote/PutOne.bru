meta {
  name: PutOne
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/Service/Cases/{{caseId}}/TrackingNotes/{{trackingNoteId}}
  body: json
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "siSMCaseTrackingNoteId": {{trackingNoteId}},
    "note": "Example tracking note",
    "time": null,
    "status": "",
    "statusId": {{selectedTrackingStatusId}},
    "appointmentId": {{appointmentId}},
    "visibleToEngineer": true,
    "visibleToCustomer": false,
    "latitude": null,
    "longitude": null
  }
}

docs {
  ### Field mapping — this request body
  Legend: Bruno var `{{appointmentId}}` | Sicon field `siconAppointmentId` | Pulse field `appointment.sicon_appointment_id`
  
  | Sicon field | Pulse field (PulseFitness.ai) | Direction | Confirmation |
  |---|---|---|---|
  | `siSMCaseTrackingNoteId` | `note.sicon_note_id` | Bidirectional |  |
  | `note` | `note.message` | Pulse→Sicon |  |
  | `time` | `note.timestamp` | Bidirectional |  |
  | `status` | `note.status` | Bidirectional |  |
  | `statusId` | `note.case_tracking_status_id` | Bidirectional |  |
  | `appointmentId` | `note.sicon_appointment_id (via linked Pulse appointment)` | Pulse→Sicon |  |
  | `visibleToEngineer` | `note.visible_to_engineer` | Bidirectional |  |
  | `visibleToCustomer` | `note.visible_to_customer` | Bidirectional |  |
  | `latitude` | `note.latitude` | Pulse→Sicon |  |
  | `longitude` | `note.longitude` | Pulse→Sicon |  |
  
}
