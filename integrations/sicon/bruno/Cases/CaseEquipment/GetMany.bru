meta {
  name: GetMany
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/service/cases/{{caseId}}
  body: none
  auth: inherit
}

params:query {
  query: $max=10
  companyId: {{companyId}}
}

docs {
  ⚠ Equipment is embedded on the case as EquipmentIDs; this points at the case read. Confirm a dedicated route with Sicon if you need the expanded equipment list.
}
