meta {
  name: GetMany
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/SiconService/Priority
  body: none
  auth: inherit
}

params:query {
  query: $max={{pageSize}}
  companyId: {{companyId}}
}

tests {
  test("HTTP status is success", function () { expect(res.getStatus()).to.be.within(200, 299); });
  const b = res.getBody() || {};
  const arr = Array.isArray(b) ? b : (b.data || b.items || b.results || b.records || []);
  const item = arr.length ? arr[0] : (Array.isArray(b) ? {} : b);
  console.log("selectedPriorityId options (set manually, do NOT auto-select):", arr.map(function (x) { return { id: x.siSMPriorityId != null ? x.siSMPriorityId : x.id, name: x.name }; }));
}

docs {
  ⚠ SICON CONFIRMATION REQUIRED — the Service WebAPI (audit R260200c) exposes NO priorities lookup endpoint. PriorityID is config-mapped in Pulse. Confirm with Sicon if a live route now exists; otherwise this request will 404.
  
  Selection lookup — do NOT auto-select the first row.
  Pick a value from the response (siSMPriorityId = id, name = label) and set {{selectedPriorityId}} in the environment.
  
}
