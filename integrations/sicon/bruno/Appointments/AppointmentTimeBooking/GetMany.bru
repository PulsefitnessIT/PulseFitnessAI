meta {
  name: GetMany
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/Service/Appointments/{{appointmentId}}/TimeBookings
  body: none
  auth: inherit
}

params:query {
  query: $max={{pageSize}}
  companyId: {{companyId}}
}

tests {
  test("HTTP status is success", function () { expect(res.getStatus()).to.be.within(200, 299); });
  const b = res.getBody() || {};
  const arr = Array.isArray(b) ? b : (b.data || b.items || b.results || b.records || []);
  const item = arr.length ? arr[0] : (Array.isArray(b) ? {} : b);
  test("field siconAppointmentId present", function () { expect(item).to.have.property("siconAppointmentId"); });
  bru.setVar("_type_siconAppointmentId", item ? typeof item["siconAppointmentId"] : "undefined");
  test("field siSMCaseId present", function () { expect(item).to.have.property("siSMCaseId"); });
  bru.setVar("_type_siSMCaseId", item ? typeof item["siSMCaseId"] : "undefined");
  test("field scheduledStartDate present", function () { expect(item).to.have.property("scheduledStartDate"); });
  bru.setVar("_type_scheduledStartDate", item ? typeof item["scheduledStartDate"] : "undefined");
}

docs {
  See FIELD_MAPPING.md / mapping.csv for the full Appointments field map (Bruno var vs Sicon field vs Pulse field, with direction).
  
}
