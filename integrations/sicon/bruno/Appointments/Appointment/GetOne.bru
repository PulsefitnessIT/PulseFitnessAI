meta {
  name: GetOne
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/~/api/v2/TEntity/api/service/appointments/{{appointmentId}}
  body: none
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

docs {
  ⚠ Appointment routes go via the TEntity v2 gateway (/~/api/v2/TEntity/...) per the current production client. Confirm against your instance.
}

script:post-response {
  const b = res.getBody() || {};
  const item = (b && b.data && !Array.isArray(b)) ? b.data : b;
  if (item) {
    if (item.siconAppointmentId != null) bru.setEnvVar('appointmentId', item.siconAppointmentId);
    else if (item.id != null) bru.setEnvVar('appointmentId', item.id);
  }
}
