meta {
  name: GetMany
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/SiconService/Equipment
  body: none
  auth: inherit
}

params:query {
  query: $max={{pageSize}}
  companyId: {{companyId}}
}

tests {
  test("HTTP status is success", function () { expect(res.getStatus()).to.be.within(200, 299); });
  const b = res.getBody() || {};
  const arr = Array.isArray(b) ? b : (b.data || b.items || b.results || b.records || []);
  const item = arr.length ? arr[0] : (Array.isArray(b) ? {} : b);
  test("field siconEquipmentId present", function () { expect(item).to.have.property("siconEquipmentId"); });
  bru.setVar("_type_siconEquipmentId", item ? typeof item["siconEquipmentId"] : "undefined");
  test("field serialNumber present", function () { expect(item).to.have.property("serialNumber"); });
  bru.setVar("_type_serialNumber", item ? typeof item["serialNumber"] : "undefined");
  test("field description present", function () { expect(item).to.have.property("description"); });
  bru.setVar("_type_description", item ? typeof item["description"] : "undefined");
  bru.setVar("_equipmentPageCount", arr.length);
  test("pagination returns a page (pageSize>10 proves full-estate retrieval)", function () { expect(arr.length).to.be.a("number"); });
}

docs {
  ⚠ SICON CONFIRMATION REQUIRED — historically the Service WebAPI has NO standalone Equipment endpoint (equipment is referenced via EquipmentIDs on a case). Confirm the live route with Sicon before use.
  
}
