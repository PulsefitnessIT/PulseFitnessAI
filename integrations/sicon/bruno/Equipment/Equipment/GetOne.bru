meta {
  name: GetOne
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/SiconService/Equipment/{{equipmentId}}
  body: none
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

script:post-response {
  const b = res.getBody() || {};
  const item = (b && b.data && !Array.isArray(b)) ? b.data : b;
  if (item) {
    if (item.siconEquipmentId != null) bru.setEnvVar('equipmentId', item.siconEquipmentId);
    else if (item.id != null) bru.setEnvVar('equipmentId', item.id);
  }
}
