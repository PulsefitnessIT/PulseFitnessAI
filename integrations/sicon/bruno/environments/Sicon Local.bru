vars {
  baseUrl: http://localhost:51080
  username: Administrator
  companyId: 2
  BEARER_TOKEN: 
  caseId: 0
  caseNumber: 0
  appointmentId: 0
  timeBookingId: 0
  trackingNoteId: 0
  equipmentId: 0
  employeeId: 0
  ALLOW_WRITES: false
  pageSize: 200
  page: 1
  equipmentSkip: 0
  selectedCaseTypeId: 
  selectedPriorityId: 
  selectedTrackingStatusId: 
}

vars:secret [
  password
]

docs {
  Set baseUrl + companyId (Sage company) and paste the secret 'password'.
  Run Auth > Authenticate first (captures BEARER_TOKEN).
  SAFETY: ALLOW_WRITES defaults to false — POST/PUT/PATCH/DELETE are blocked
  until you set ALLOW_WRITES=true (Auth is exempt).
  SELECTION: choose selectedCaseTypeId / selectedPriorityId / selectedTrackingStatusId
  from the Metadata lookup responses — they are NOT auto-selected.
  Entity ids (caseId/appointmentId/...) are captured from create/get responses.
}
