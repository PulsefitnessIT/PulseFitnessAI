meta {
  name: FaultCodes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/service/fault-codes
  body: none
  auth: inherit
}

params:query {
  companyId: {{companyId}}
  $max: {{pageSize}}
}

tests {
  test("HTTP status is success", function () { expect(res.getStatus()).to.be.within(200, 299); });
  const b = res.getBody() || {};
  const arr = Array.isArray(b) ? b : (b.data || b.items || b.results || []);
  console.log("FaultCodes lookup count:", arr.length);
}

docs {
  ⚠ Fault codes -> Pulse issue.fault_code. Direction: Sicon metadata. SICON CONFIRMATION REQUIRED: route unconfirmed.
}
