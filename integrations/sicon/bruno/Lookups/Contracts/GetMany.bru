meta {
  name: Contracts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/service/contracts
  body: none
  auth: inherit
}

params:query {
  companyId: {{companyId}}
  $max: {{pageSize}}
}

tests {
  test("HTTP status is success", function () { expect(res.getStatus()).to.be.within(200, 299); });
  const b = res.getBody() || {};
  const arr = Array.isArray(b) ? b : (b.data || b.items || b.results || []);
  console.log("Contracts lookup count:", arr.length);
}

docs {
  ⚠ Contracts lookup -> Pulse contract.sicon_contract_id. SICON CONFIRMATION REQUIRED: GET route unconfirmed (the Contract API is POST-only for create/update).
}
