meta {
  name: Ping
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/SiconService/Ping
  body: none
  auth: none
}

params:query {
  companyId: {{companyId}}
}

script:post-response {
  test('status is 200', function () { if (res.getStatus() !== 200) throw new Error('HTTP ' + res.getStatus()); });
}
