meta {
  name: Authenticate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/authentication/authenticate
  body: json
  auth: none
}

params:query {
  companyId: {{companyId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": {{username}},
    "password": {{password}}
  }
}

docs {
  NOTE: this is the ONLY write-exempt POST — it carries no ALLOW_WRITES
  guard because you must authenticate before anything else (including enabling writes).
  All business POST/PUT requests DO enforce the ALLOW_WRITES guard.
}

script:post-response {
  const b = res.getBody() || {};
  const t = b.accessToken || b.token;
  if (t) bru.setEnvVar('BEARER_TOKEN', t);
  test('got token', function () { if (!t) throw new Error('no accessToken'); });
}
