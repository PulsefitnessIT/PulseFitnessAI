meta {
  name: Authenticate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/authentication/authenticate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": {{username}},
    "password": {{password}}
  }
}

script:post-response {
  const b = res.getBody();
  if (b && b.accessToken) bru.setEnvVar('BEARER_TOKEN', b.accessToken);
}
