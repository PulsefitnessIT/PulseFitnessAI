meta {
  name: PutOne
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/SiconService/Case/{{caseId}}
  body: json
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

script:pre-request {
  if (String(bru.getEnvVar('ALLOW_WRITES')).toLowerCase() !== 'true') {
    throw new Error('WRITE BLOCKED: initial mapping is READ-ONLY. Set ALLOW_WRITES=true to run POST/PUT.');
  }
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "siSMCaseId": {{caseId}},
    "caseNumber": "",
    "siSMDocumentStatusId": 0,
    "siSMDocumentStatusName": "",
    "siSMDocumentSubStatusId": 0,
    "summary": "Example",
    "description": "Example",
    "callDate": null,
    "contactName": "",
    "contactPhoneNumber": "",
    "contactEmail": "",
    "lastUpdatedDate": null,
    "isNonContract": false,
    "address": {
      "postalName": "",
      "addressLine1": "",
      "addressLine2": "",
      "addressLine3": "",
      "addressLine4": "",
      "city": "",
      "county": "",
      "postCode": "",
      "sopDelAddress": null
    },
    "customerOrderNo": "",
    "createdBy": "",
    "analysisField1": "",
    "analysisField2": "",
    "analysisField3": "",
    "analysisField4": "",
    "analysisField5": "",
    "analysisField6": "",
    "analysisField7": "",
    "analysisField8": "",
    "analysisField9": "",
    "analysisField10": "",
    "analysisField11": "",
    "analysisField12": "",
    "analysisField13": "",
    "analysisField14": "",
    "analysisField15": "",
    "analysisField16": "",
    "analysisField17": "",
    "analysisField18": "",
    "analysisField19": "",
    "analysisField20": "",
    "siconCRMPersonId": {{crmPersonId}},
    "siconCRMCompanyId": {{crmCompanyId}},
    "caseType": {
      "siSMCaseTypeId": {{caseTypeId}},
      "name": "",
      "systemType": "",
      "isPreventativeMaintenanceType": false,
      "isEnabled": true,
      "isCustom": false,
      "defaultAppointmentLabel": null
    },
    "coverType": null,
    "sla": null,
    "faultCode": null,
    "skill": null,
    "priority": {
      "siSMPriorityId": {{priorityId}},
      "name": "",
      "colour": ""
    },
    "lastTrackingStatus": null,
    "contract": null,
    "contractLine": null,
    "project": null,
    "caseAdmin": null,
    "internalTeamId": {{internalTeamId}},
    "internalTeam": null,
    "externalTeamId": {{externalTeamId}},
    "externalTeam": null,
    "customer": null,
    "customerContact": null,
    "subLocation": null,
    "equipmentIds": []
  }
}

script:post-response {
  test('status is 2xx', function () { if (res.getStatus() >= 300) throw new Error('HTTP ' + res.getStatus()); });
  const b = res.getBody() || {};
  const e = (b && b.entity) ? b.entity : b;
  const first = Array.isArray(e) ? (e[0] || {}) : (Array.isArray(b.items) ? (b.items[0]||{}) : e);
  if (first && first.siSMCaseId !== undefined && first.siSMCaseId !== null) bru.setVar('caseId', first.siSMCaseId);
  if (first && first.caseNumber !== undefined && first.caseNumber !== null) bru.setVar('caseNumber', first.caseNumber);
}
