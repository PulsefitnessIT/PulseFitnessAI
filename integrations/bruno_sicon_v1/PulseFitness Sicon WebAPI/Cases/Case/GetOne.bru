meta {
  name: GetOne
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/SiconService/Case/{{caseId}}
  body: none
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

script:post-response {
  test('status is 200', function () { if (res.getStatus() !== 200) throw new Error('HTTP ' + res.getStatus()); });
  test('has siSMCaseId', function () { const b=res.getBody()||{}; const e=Array.isArray(b)?(b[0]||{}):((b.entity)||b); if (e && e.siSMCaseId === undefined) throw new Error('missing siSMCaseId'); });
}
