meta {
  name: PutOne
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/SiconService/Case/{{caseId}}/TrackingNote/{{trackingNoteId}}
  body: json
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

script:pre-request {
  if (String(bru.getEnvVar('ALLOW_WRITES')).toLowerCase() !== 'true') {
    throw new Error('WRITE BLOCKED: initial mapping is READ-ONLY. Set ALLOW_WRITES=true to run POST/PUT.');
  }
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "siSMCaseTrackingNoteId": {{trackingNoteId}},
    "note": "Example",
    "time": null,
    "status": "",
    "statusId": {{statusId}},
    "appointmentId": {{appointmentId}},
    "visibleToEngineer": true,
    "visibleToCustomer": false,
    "reassignedToCaseOwnerId": null,
    "reassignedToInternalTeamId": null,
    "reassignedToExternalTeamId": null,
    "latitude": null,
    "longitude": null
  }
}

script:post-response {
  test('status is 2xx', function () { if (res.getStatus() >= 300) throw new Error('HTTP ' + res.getStatus()); });
  const b = res.getBody() || {};
  const e = (b && b.entity) ? b.entity : b;
  const first = Array.isArray(e) ? (e[0] || {}) : (Array.isArray(b.items) ? (b.items[0]||{}) : e);
  if (first && first.siSMCaseTrackingNoteId !== undefined && first.siSMCaseTrackingNoteId !== null) bru.setVar('trackingNoteId', first.siSMCaseTrackingNoteId);
}
