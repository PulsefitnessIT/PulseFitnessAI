meta {
  name: PutOne
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/SiconService/Appointment/{{appointmentId}}
  body: json
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

script:pre-request {
  if (String(bru.getEnvVar('ALLOW_WRITES')).toLowerCase() !== 'true') {
    throw new Error('WRITE BLOCKED: initial mapping is READ-ONLY. Set ALLOW_WRITES=true to run POST/PUT.');
  }
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "siconAppointmentId": {{appointmentId}},
    "siSMCaseId": {{caseId}},
    "appointmentType": "Work",
    "parentWorkAppointmentId": null,
    "subject": "Example",
    "description": "",
    "workBriefing": "",
    "employeeIds": [
      {{employeeId}}
    ],
    "chargeRateId": null,
    "labelId": null,
    "colour": "",
    "confirmed": false,
    "scheduledStartDate": "2026-01-01T09:00:00",
    "scheduledEndDate": "2026-01-01T17:00:00",
    "appointmentComplete": false,
    "workDoneDescription": "",
    "workDoneAcknowledged": false,
    "furtherAction": "",
    "furtherActionAcknowledged": false,
    "arrivalSignee": "",
    "departureSignee": "",
    "arrivalLatitude": null,
    "arrivalLongitude": null,
    "departureLatitude": null,
    "departureLongitude": null
  }
}

script:post-response {
  test('status is 2xx', function () { if (res.getStatus() >= 300) throw new Error('HTTP ' + res.getStatus()); });
  const b = res.getBody() || {};
  const e = (b && b.entity) ? b.entity : b;
  const first = Array.isArray(e) ? (e[0] || {}) : (Array.isArray(b.items) ? (b.items[0]||{}) : e);
  if (first && first.siconAppointmentId !== undefined && first.siconAppointmentId !== null) bru.setVar('appointmentId', first.siconAppointmentId);
}
