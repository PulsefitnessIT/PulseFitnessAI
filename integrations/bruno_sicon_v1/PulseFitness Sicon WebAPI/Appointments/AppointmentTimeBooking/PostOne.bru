meta {
  name: PostOne
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/SiconService/Appointment/{{appointmentId}}/TimeBooking
  body: json
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

script:pre-request {
  if (String(bru.getEnvVar('ALLOW_WRITES')).toLowerCase() !== 'true') {
    throw new Error('WRITE BLOCKED: initial mapping is READ-ONLY. Set ALLOW_WRITES=true to run POST/PUT.');
  }
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "employeeIds": [
      {{employeeId}}
    ],
    "startDate": "2026-01-01T09:00:00",
    "endDate": "2026-01-01T17:00:00",
    "costingHours": null,
    "chargingHours": null,
    "chargeRate": null,
    "isEstimate": false
  }
}

script:post-response {
  test('status is 2xx', function () { if (res.getStatus() >= 300) throw new Error('HTTP ' + res.getStatus()); });
  const b = res.getBody() || {};
  const e = (b && b.entity) ? b.entity : b;
  const first = Array.isArray(e) ? (e[0] || {}) : (Array.isArray(b.items) ? (b.items[0]||{}) : e);
  if (first && first.timeBookingId !== undefined && first.timeBookingId !== null) bru.setVar('timeBookingId', first.timeBookingId);
  if (first && first.id !== undefined && first.id !== null) bru.setVar('timeBookingId', first.id);
}
