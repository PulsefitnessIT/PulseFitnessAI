meta {
  name: PutOne
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/SiconService/Equipment/{{equipmentId}}
  body: json
  auth: inherit
}

params:query {
  companyId: {{companyId}}
}

script:pre-request {
  if (String(bru.getEnvVar('ALLOW_WRITES')).toLowerCase() !== 'true') {
    throw new Error('WRITE BLOCKED: initial mapping is READ-ONLY. Set ALLOW_WRITES=true to run POST/PUT.');
  }
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "siconEquipmentId": {{equipmentId}},
    "itemId": null,
    "description": "Example",
    "serialNumber": "",
    "idNumber": "",
    "warrantyExpiry": null,
    "installDate": null,
    "serviceIntervalMeasurement": "",
    "serviceIntervalDuration": null,
    "notes": "",
    "customerId": null,
    "siconEquipmentGroupDbKey": null,
    "make": "",
    "model": "",
    "lastServiceDate": null,
    "nextServiceDate": null,
    "siconCrmCompanyId": null,
    "siconCrmPersonId": null,
    "siconCrmEndUserCompanyId": null,
    "siconCrmEndUserPersonId": null,
    "custDeliveryAddressDbKey": null,
    "siconSubLocationDbKey": null,
    "siconContactDbKey": null,
    "analysisCode1": "",
    "analysisCode2": "",
    "analysisCode3": "",
    "analysisCode4": "",
    "analysisCode5": "",
    "analysisCode6": "",
    "analysisCode7": "",
    "analysisCode8": "",
    "analysisCode9": "",
    "analysisCode10": "",
    "analysisCode11": "",
    "analysisCode12": "",
    "analysisCode13": "",
    "analysisCode14": "",
    "analysisCode15": "",
    "analysisCode16": "",
    "analysisCode17": "",
    "analysisCode18": "",
    "analysisCode19": "",
    "analysisCode20": ""
  }
}

script:post-response {
  test('status is 2xx', function () { if (res.getStatus() >= 300) throw new Error('HTTP ' + res.getStatus()); });
  const b = res.getBody() || {};
  const e = (b && b.entity) ? b.entity : b;
  const first = Array.isArray(e) ? (e[0] || {}) : (Array.isArray(b.items) ? (b.items[0]||{}) : e);
  if (first && first.siconEquipmentId !== undefined && first.siconEquipmentId !== null) bru.setVar('equipmentId', first.siconEquipmentId);
}
