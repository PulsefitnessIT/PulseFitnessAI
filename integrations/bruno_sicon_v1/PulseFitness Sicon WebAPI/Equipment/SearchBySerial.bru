meta {
  name: SearchBySerial
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/SiconService/Equipment
  body: none
  auth: inherit
}

params:query {
  query: $filter=serialNumber eq '{{serialNumber}}'&$max={{pageSize}}
  companyId: {{companyId}}
}

script:post-response {
  test('status is 200', function () { if (res.getStatus() !== 200) throw new Error('HTTP ' + res.getStatus()); });
}
